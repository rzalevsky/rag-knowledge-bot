# eBay REST API app credentials — create an app at developer.ebay.com (eBay
# Developers Program account required, that signup step is manual and not part
# of this repo). Only "Application access" (client_credentials grant, no user
# login) is used — this project only reads public listing search results, it
# never acts on behalf of a buyer or seller account.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

EBAY_AUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_URL=https://api.ebay.com

# Which eBay site to search — confirmed from eBay's own docs that this header
# is optional, not yet confirmed that "EBAY_PL" is the right value for it (or
# that Polish listings even need it vs. a global search with a location
# filter) — check the first real response and adjust.
EBAY_MARKETPLACE_ID=EBAY_PL

# Free-text query passed to the Browse API search.
SEARCH_PHRASE=laptop

# "PC Laptops & Netbooks" — confirmed live via the Taxonomy API's
# get_category_suggestions for q="laptop" on EBAY_PL. Without this, a
# plain-text "laptop" search also returns batteries, chargers, cases, and
# replacement screens. Browse API allows only one category_ids value per
# request, so "Apple Laptops" (111422) is out of scope for now.
EBAY_CATEGORY_IDS=177

# The actual "ships to Poland" filter — X-EBAY-C-MARKETPLACE-ID (below) only
# sets currency/locale, not item location or shipping.
EBAY_DELIVERY_COUNTRY=PL

# Hard ceiling on how many items a single ingest run pulls, regardless of how
# many the search reports. Keeps a first run fast and predictable while the
# pipeline is still being built; raise it once ingest → embed → upsert is
# proven end to end.
MAX_OFFERS=200

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=laptop_offers
